{
  "name": "agent-deck-release",
  "private": true,
  "description": "semantic-release for agent-deck, pinned here so dependabot keeps it up to date. Run by .github/workflows/release.yml.",
  "engines": { "node": "24.22.2" },
  "devDependencies": {
    "semantic-release": "25.0.9",
    "conventional-changelog-conventionalcommits": "9.3.1"
  },
  "release": {
    "branches": ["main"],
    "tagFormat": "v${version}",
    "plugins": [
      ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
      ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
      ["@semantic-release/github", { "successComment": false, "failComment": false, "releasedLabels": false }]
    ]
  }
}
